# ─────────────────────────────────────────────────────
# Convex Environment Variables Template
# {SLUG} and {DOMAIN} are auto-replaced by provision-customer.sh
# Lines with REPLACE_ME require manual setup
# ─────────────────────────────────────────────────────

# Auth & Security (auto-generated per customer)
ALLOWED_ORIGIN=https://{DOMAIN}
INTEGRATION_ENCRYPTION_KEY={AUTO_GENERATED}

# Clerk (shared across all customers)
CLERK_JWT_ISSUER_DOMAIN=https://clerk.valence.ai

# SSH Proxy (runs on the customer's Lightsail agent server)
SSH_PROXY_URL=http://{LIGHTSAIL_IP}:3001
SSH_PROXY_SECRET={AUTO_GENERATED}

# Agent Wakeup (runs on the customer's Lightsail agent server)
AGENT_WAKEUP_WEBHOOK_URL=http://{LIGHTSAIL_IP}:3333
AGENT_WAKEUP_WEBHOOK_SECRET={AUTO_GENERATED}

# Anthropic (for doc scraper)
ANTHROPIC_API_KEY=REPLACE_ME

# Stripe (optional — billing not enforced during pilot)
# STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# STRIPE_PRICE_STARTER=price_REPLACE_ME
# STRIPE_PRICE_PRO=price_REPLACE_ME
# STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME

# OAuth App Secrets (shared across customers — get from oauth-apps.json)
# OAUTH_SECRET_GITHUB=REPLACE_ME
# OAUTH_SECRET_SLACK=REPLACE_ME
# OAUTH_SECRET_GOOGLE=REPLACE_ME
