# ============================================================
# Valence AI — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Convex-side secrets are set via: npx convex env set KEY value

# ─── Convex (Backend) ─────────────────────────────────────────
# Create a free Convex project at https://convex.dev
# Run: npx convex dev  (first run prompts you to log in + create a project)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# ─── Clerk (Authentication) ───────────────────────────────────
# Create a free Clerk app at https://clerk.com (10k MAU free)
# Dashboard → API Keys → copy "Publishable key"
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# ─── SSH Proxy Service ────────────────────────────────────────
# URL of your running ssh-proxy-server.js (server-files/ssh-proxy-server.js)
# This runs on your Linux server on port 3001
VITE_SSH_PROXY_URL=http://your-server-ip:3001

# ─── Convex env vars ─────────────────────────────────────────
# Set these via: npx convex env set KEY value
#
# Agent wakeup webhook (OpenClaw wakeup server on port 3333):
#   AGENT_WAKEUP_WEBHOOK_URL=http://your-server-ip:3333
#   AGENT_WAKEUP_WEBHOOK_SECRET=your-32-char-hmac-secret
#
# SSH proxy URL (server-side, used for agent registration):
#   SSH_PROXY_URL=http://your-server-ip:3001
#
# Integration Engine encryption key (AES-256-GCM):
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   INTEGRATION_ENCRYPTION_KEY=your-64-char-hex-key
#
# Anthropic AI (doc scraper, autopilot, soul distillation):
#   ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# OAuth secrets — one per integration you enable:
#   OAUTH_SECRET_GITHUB=your-github-oauth-client-secret
#   OAUTH_SECRET_GOOGLE=your-google-oauth-client-secret
#   OAUTH_SECRET_SLACK=your-slack-oauth-client-secret
#   OAUTH_SECRET_NOTION=your-notion-oauth-client-secret
#   OAUTH_SECRET_HUBSPOT=your-hubspot-oauth-client-secret
#   OAUTH_SECRET_JIRA=your-jira-oauth-client-secret

# ─── Optional: Voice Briefings ────────────────────────────────
# WebSocket URL for voice proxy (optional feature, requires separate service)
# VITE_VOICE_PROXY_URL=ws://your-server-ip:3002/ws/voice
# VITE_VOICE_PROXY_SECRET=your-voice-proxy-secret
